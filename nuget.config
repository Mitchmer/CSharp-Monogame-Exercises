<configuration>
	<packageSources>
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</packageSources>

	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
			<package pattern="dotnet-mgcb*" />
			<package pattern="MonoGame.*" />
		</packageSource>
	</packageSourceMapping>
</configuration>